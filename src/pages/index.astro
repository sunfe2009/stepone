---
import { Header } from '@components/misc';
import { BaseHead } from '@components/seo';
import { products, SITE_TITLE } from '@data/index';
import { SITE_DESCRIPTION, socialLinks } from '@data/index';
import RootLayout from '@layouts/root-layout.astro';
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image='/images/ogimage.png'
		/>
	</head>

	<RootLayout>
		<div
			id='navbar+title'
			class='flex flex-col w-full gap-6 max-w-xl'>
			<Header />
			<div class='flex flex-row gap-6 items-center'>
				<img
					src='/images/logo.png'
					alt='The Step One Logo'
					class='w-24 h-24 object-contain flex-shrink-0 rounded-full'
				/>
				<div class='flex flex-col gap-2'>
					<h1
						class='w-full text-start text-[min(8vw,36px)] font-medium leading-[1.1] tracking-[-1px] sm:tracking-[-2px]'>
						The Step One
					</h1>
					<h2
						class='w-full text-start text-[min(8vw,36px)] font-medium leading-[1.1] tracking-[-1px] sm:tracking-[-2px]'>
						<span class='text-gray-500 dark:text-gray-400'>小步向前</span>
					</h2>
				</div>
			</div>

			<div
				id='about'
				class='flex flex-col gap-4'>
				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					你好，我是牧辉，前广告人，现为自由职业。混迹于上海街头，这里是我记录想法的地方。
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-300'>
					最近在折腾：
					<div class='flex flex-wrap gap-2 mt-5'>
						{
							products.map((product) => (
								<a
									href={product.url}
									target='_blank'
									class='p-2 rounded-full gap-2 flex-wrap hover:rotate-1 hover:scale-105 transition-all duration-300 flex items-center justify-center bg-gray-100 hover:bg-gray-200 dark:bg-[#1F1F1F] dark:hover:bg-[#2F2F2F]'>
									<img
										src={product.image}
										alt={product.name}
										class='size-9'
									/>
									<span class='mr-2'>{product.name}</span>
								</a>
							))
						}
					</div>
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					我很乐意认识新朋友。如果你想打个招呼，欢迎点击下方的链接，我们可以就像和火车上的陌生人那样聊几句。
				</div>

				<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					约个时间?
					<a
						href='https://cal.com/molight/quick-chat'
						target='_blank'
						class='underline underline-offset-2'>
						schedule a call
					</a>
				</div>
			</div>

			<div class='font-medium text-lg text-gray-700 dark:text-gray-400'>
					也可以在这里找到我 👇🏻
				</div>

			<div
				id='social-links'
				class='flex flex-row gap-4'>
				{
					socialLinks.map((link) => (
						<a
							href={link.url}
							class='text-lg font-medium text-gray-700 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:underline underline-offset-2'>
							{link.label}
						</a>
					))
				}
			</div>
		</div>
	</RootLayout>
</html>
